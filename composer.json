{
    "name": "siberfx/laravel-gemini",
    "description": "A production-ready Laravel package to integrate with the Google Gemini API. Supports text, image, video, audio, long-context, structured output, files, caching, function-calling and understanding capabilities.",
    "keywords": [
        "laravel",
        "gemini",
        "google-gemini",
        "ai",
        "llm",
        "api",
        "google",
        "siberfx"
    ],
    "homepage": "https://github.com/siberfx/laravel-gemini",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "homepage": "https://github.com/siberfx",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/siberfx/laravel-gemini/issues",
        "source": "https://github.com/siberfx/laravel-gemini"
    },
    "require": {
        "php": "~8.4.0|~8.5.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\LaravelGemini\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\LaravelGemini\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\LaravelGemini\\GeminiServiceProvider"
            ],
            "aliases": {
                "Gemini": "Siberfx\\LaravelGemini\\Facades\\Gemini"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
